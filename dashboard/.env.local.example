# Copy this file to .env.local and fill in your key, then restart `npm run dev`.
# Only the Research page's "Research a symbol" box needs this — everything
# else in the dashboard is keyless by design (see README's "Data sources").
#
# Get a key at https://console.anthropic.com/settings/keys — each research
# request costs a small amount (one Claude Sonnet 5 call, medium effort, with web search).
ANTHROPIC_API_KEY=
